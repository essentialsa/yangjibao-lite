+      const s = (line || '').trim();
+      if (/代码/.test(s) && /份额/.test(s)) colRoles = this.headerRoles(s);
+      const r = this.fromLine(line, i + 1, colRoles);
+      if (!r) return;               // 空行 / 表头行 / 分隔行直接跳过
