+    const paused = p.active === false;
+    const nextTxt = st.next || (paused ? '已暂停' : '—');
+    const valueTxt = st.hasHolding ? '¥' + moneyFull0(st.value) : '--';
+    const profitTxt = st.hasHolding
+      ? moneyFull(st.profit) + '（' + pctTxt(st.profitPct) + '）'
+      : '--';
+    return '<div class="pcard" style="padding:14px;margin-bottom:10px">'
+      + '<div style="display:flex;justify-content:space-between;align-items:baseline">'
+      + '<div><b>' + dcaEsc(p.name) + '</b> <span class="t-dim t-sm">' + p.code + '</span></div>'
+      + '<span class="t-sm"' + (paused ? ' style="color:var(--dim)"' : '') + '>' + (paused ? '已暂停' : '执行中') + '</span>'
+      + '</div>'
+      + '<div class="kv"><span class="k">每月</span><span class="v">' + p.day + ' 日 · ' + fmt(p.amount, 0) + ' 元</span></div>'
+      + '<div class="kv"><span class="k">下次</span><span class="v">' + nextTxt + '</span></div>'
+      + '<div class="kv"><span class="k">累计投入</span><span class="v">¥' + moneyFull0(st.invested) + '（已买 ' + st.entries.length + ' 笔）</span></div>'
+      + '<div class="kv"><span class="k">总份额 / 均价</span><span class="v">' + fmt(st.shares, 2) + ' 份 · ' + (st.shares > 0 ? fmt(st.costNav, 4) : '--') + '</span></div>'
+      + '<div class="kv"><span class="k">当前市值 / 收益</span><span class="v">' + valueTxt + ' / ' + profitTxt + '</span></div>'
+      + '<div style="display:flex;gap:6px;margin-top:10px">'
+      + '<button class="btn primary" style="flex:1" onclick="openDcaBuy(\'' + p.code + '\')">记一笔</button>'
+      + '<button class="btn" style="flex:1" onclick="openDcaLog(\'' + p.code + '\')">记录</button>'
+      + '<button class="btn" style="flex:1" onclick="dcaTogglePlan(\'' + p.code + '\')">' + (paused ? '恢复' : '暂停') + '</button>'
+      + '<button class="btn" style="flex:1" onclick="openDcaPlanForm(\'' + p.code + '\')">编辑</button>'
+      + '</div>'
+      + '<div style="margin-top:8px;text-align:right"><span class="t-xs t-dim" style="cursor:pointer" onclick="dcaDeletePlan(\'' + p.code + '\')">删除计划</span></div>'
+      + '</div>';
+  }).join('');
+  openSheet(
+    '<div class="sheet-x" onclick="closeSheet()">✕</div>'
+    + '<div class="sheet-h">定投管理</div>'
+    + '<div class="sheet-body">'
+    + (cards || '<div class="t-dim t-sm" style="padding:12px 0">还没有定投计划。每月固定一天买固定金额，记一笔就自动算好份额与均价。</div>')
+    + '<button class="btn primary" onclick="openDcaPlanForm()">新建定投计划</button>'
+    + '<div class="t-xs t-dim" style="margin-top:10px">份额与均价由购买记录自动推导；要改数请改购买记录，不要直接改持仓（会被下一次记账覆盖）。不发提醒，只显示下次日期。</div>'
+    + '</div>'
+  );
+}
+
+/** 新建 / 编辑定投计划。code 为空时新建。 */
+function openDcaPlanForm(code) {
+  const plan = code ? dca.planFor(code) : null;
+  const isEdit = !!plan;
+  const t = todayStr();
+  openSheet(`
+    <div class="sheet-x" onclick="closeSheet()">✕</div>
+    <div class="sheet-h">${isEdit ? '编辑定投计划' : '新建定投计划'}</div>
+    <div class="sheet-body">
+    ${isEdit
+      ? `<div class="kv"><span class="k">基金</span><span class="v">${dcaEsc(plan.name)} · ${plan.code}</span></div>`
+      : `<div class="field"><label>基金代码（6 位）</label>
+        <input id="dcaCode" inputmode="numeric" maxlength="6" placeholder="如 007466"></div>`}
+    <div class="field"><label>每期金额（元）</label>
+      <input id="dcaAmount" type="number" inputmode="decimal" placeholder="如 1000"
+        value="${isEdit ? plan.amount : ''}"></div>
+    <div class="field"><label>每月几号</label>
+      <input id="dcaDay" type="number" inputmode="numeric" placeholder="1-31，如 15"
+        value="${isEdit ? plan.day : ''}"></div>
+    <div class="field"><label>开始日期</label>
+      <input id="dcaStart" type="date" value="${isEdit ? plan.startDate : t}"></div>
+    ${isEdit ? `<div class="field"><label>状态</label>
+      <div class="sectabs" style="margin:0">
+        <button type="button" data-active="1" class="${plan.active !== false ? 'on' : ''}" style="flex:1">执行中</button>
+        <button type="button" data-active="0" class="${plan.active === false ? 'on' : ''}" style="flex:1">已暂停</button>
+      </div></div>` : ''}
+    ${isEdit && plan.baseShares > 0
+      ? `<div class="t-sm t-dim" style="margin:-4px 0 12px">基线：建计划时持有 ${fmt(plan.baseShares, 2)} 份，均价 ${fmt(plan.baseCostNav, 4)}（建计划时定的，编辑不改）。</div>`
+      : ''}
+    <button class="btn primary" id="dcaPlanOk">保存</button>
+    <button class="btn" onclick="closeSheet()">取消</button>
+    </div>
+  `);
+
+  // 状态切换（编辑时才有）
+  let active = plan ? plan.active !== false : true;
+  const box = document.getElementById('sheet');
+  box.querySelectorAll('[data-active]').forEach(b => {
+    b.onclick = () => {
+      box.querySelectorAll('[data-active]').forEach(x => x.classList.remove('on'));
+      b.classList.add('on');
+      active = b.dataset.active === '1';
+    };
+  });
+
+  document.getElementById('dcaPlanOk').onclick = async () => {
+    const amount = parseFloat(document.getElementById('dcaAmount').value);
+    const day = parseInt(document.getElementById('dcaDay').value, 10);
+    const startDate = document.getElementById('dcaStart').value || todayStr();
+    if (isEdit) {
+      const r = dca.updatePlan(code, { amount, day, startDate, active });
+      if (!r.ok) { toast(r.error); return; }
+      closeSheet(); render(); toast('已保存'); openDca();
+      return;
+    }
+    const codeVal = document.getElementById('dcaCode').value.trim();
+    if (!/^\d{6}$/.test(codeVal)) { toast('基金代码应为 6 位数字'); return; }
+    // 查名字（和批量导入同一套）；查不到就用代码当名字
+    let name = codeVal;
+    try {
+      const found = (await api.search(codeVal)).find(o => o.code === codeVal);
