+          : (j.code ? [j] : null));
+        if (!arr) throw new Error('JSON 里没有持仓数组');
+        arr.forEach((o, i) => {
+          const r = this.fromObject(o, i + 1);
+          (r.error ? errors : rows).push(r);
+        });
+        // 导出 JSON 里还可能有定投数据（v1.2.0 起导出带上）
+        const dcaData = dca.parseExport(j);
+        if (dcaData && dcaData.errors.length) errors.push(...dcaData.errors.map(e => ({ error: e })));
+        return { rows: this.dedupe(rows), errors, dca: dcaData };
