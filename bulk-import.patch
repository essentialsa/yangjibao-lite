+/** 给一个计划记一笔购买。净值默认取当日最新净值，份额自动算出，都可改。 */
+function openDcaBuy(code) {
+  const plan = dca.planFor(code);
+  if (!plan) { toast('计划不存在'); return; }
+  const t = todayStr();
+  const pair = navPairOf(code);
+  const curNav = pair && isFinite(pair.curNav) && pair.curNav > 0 ? pair.curNav : null;
+  openSheet(`
+    <div class="sheet-x" onclick="closeSheet()">✕</div>
+    <div class="sheet-h">记一笔 · ${dcaEsc(plan.name)}</div>
+    <div class="sheet-body">
+    <div class="field"><label>购买日期</label>
+      <input id="dcaBuyDate" type="date" value="${t}"></div>
+    <div class="field"><label>实付金额（元）</label>
+      <input id="dcaBuyAmount" type="number" inputmode="decimal"
+        value="${plan.amount}" placeholder="如 1000"></div>
+    <div class="field"><label>当日净值</label>
+      <input id="dcaBuyNav" type="number" inputmode="decimal"
+        value="${curNav != null ? curNav : ''}" placeholder="如 1.2345"></div>
+    <div class="field"><label>到账份额（自动算出，可改）</label>
+      <input id="dcaBuyShares" type="number" inputmode="decimal" placeholder="金额 ÷ 净值"></div>
+    <div class="t-xs t-dim" style="margin:-4px 0 12px">平台扣了手续费就按实到份额改，份额与均价按实到算。</div>
+    <button class="btn primary" id="dcaBuyOk">保存</button>
+    <button class="btn" onclick="closeSheet()">取消</button>
+    </div>
+  `);
+
+  // 金额或净值一改，份额就重算（手动改完份额再动金额/净值会覆盖一次）
+  const amtEl = document.getElementById('dcaBuyAmount');
+  const navEl = document.getElementById('dcaBuyNav');
+  const shEl = document.getElementById('dcaBuyShares');
+  const calc = () => {
+    const a = parseFloat(amtEl.value), n = parseFloat(navEl.value);
+    if (a > 0 && n > 0) shEl.value = (Math.round(a / n * 100) / 100).toFixed(2);
+  };
+  amtEl.oninput = calc;
+  navEl.oninput = calc;
+  calc();
+
+  document.getElementById('dcaBuyOk').onclick = async () => {
