+    ? '<div class="t-sm t-dim" style="margin-bottom:8px">基线：建计划时持有 ' + fmt(plan.baseShares, 2) + ' 份，均价 ' + fmt(plan.baseCostNav, 4) + '</div>'
+    : '';
+  openSheet(
+    '<div class="sheet-x" onclick="closeSheet()">✕</div>'
+    + '<div class="sheet-h">购买记录 · ' + dcaEsc(plan.name) + '</div>'
