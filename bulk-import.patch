+    const profitTxt = st.hasHolding
+      ? moneyFull(st.profit) + '（' + pctTxt(st.profitPct) + '）'
+      : '--';
+    return '<div class="pcard" style="padding:14px;margin-bottom:10px">'
+      + '<div style="display:flex;justify-content:space-between;align-items:baseline">'
