+  },
+
+  /** 表头行 → 每列的角色（gain / cost / shares / date / code / ''）。 */
+  headerRoles(line) {
+    return this.splitCells(line).map(c =>
+      /收益/.test(c) ? 'gain'
+      : /成本/.test(c) ? 'cost'
+      : /份额/.test(c) ? 'shares'
+      : /日期|买入/.test(c) ? 'date'
+      : /代码/.test(c) ? 'code' : '');
+  },
+
+  /** 对象形式（JSON 里的一只）→ 行；字段名中英都认。 */
+  fromObject(o, n) {
+    if (!o || typeof o !== 'object') return { error: '第 ' + n + ' 条不是对象' };
+    const code = String(o.code || o['代码'] || '').trim();
+    const shares = parseFloat(o.shares ?? o['份额'] ?? o['份']);
+    const cost = parseFloat(o.costNav ?? o.cost ?? o['成本净值'] ?? o['成本']);
+    // 按收益导入：gain（别名 profit / 持有收益）优先于 costNav。
+    const gainRaw = o.gain ?? o.profit ?? o['持有收益'];
+    const gain = (gainRaw == null || gainRaw === '') ? null : parseFloat(gainRaw);
+    const buyDate = this.normDate(o.buyDate || o['买入日期'] || o['买入日'] || '');
+    const name = String(o.name || o['基金名'] || o['名称'] || '').trim();
+    const group = String(o.group || o['分组'] || '').trim();
+    const divMode = o.divMode === 'reinvest' ? 'reinvest' : '';
+    const r = this.makeRow(code, shares, cost, buyDate, name, '第 ' + n + ' 条', gain);
+    if (!r.error) { if (group) r.group = group; if (divMode) r.divMode = divMode; }
+    return r;
+  },
+
+  /** 文本行 → 行。colRoles：Markdown 表头给出的列角色（与 parts 下标对齐）。 */
+  fromLine(line, n, colRoles) {
+    let s = (line || '').trim();
+    if (!s) return null;
+    if (/^[\s|:\-]+$/.test(s)) return null;            // Markdown 表格分隔行
+    if (/代码/.test(s) && /份额/.test(s)) return null;  // 表头行
+    // 先按空白 / 分号 / 竖线切分；每段里再判断逗号是千分位还是分隔符：
+    // 1,681.76 这类「1~3 位 + (,三位)+」整体是千分位数字，去掉逗号；
+    // 其余含逗号的段（如 018738,1681.76）按逗号切成多个字段。
+    const parts = this.splitCells(s);
+    const ci = parts.findIndex(p => /^\d{6}$/.test(p));
+    if (ci < 0) return { error: '第 ' + n + ' 行：找不到 6 位基金代码' };
+    const code = parts[ci];
+    // 日期先抠出来，剩下的数字按顺序是份额、成本/收益
+    const di = parts.findIndex(p => /^\d{4}[-/.]\d{1,2}[-/.]\d{1,2}$/.test(p));
+    const buyDate = di >= 0 ? this.normDate(parts[di]) : '';
+    const isNum = p => /^[+-]?\d+(\.\d+)?$/.test(p);
+    const numIdx = [];
+    parts.forEach((p, i) => { if (i !== ci && i !== di && isNum(p)) numIdx.push(i); });
+    const shares = Number(parts[numIdx[0]]);
+    /*
+     * 第二个及以后的数字：表头指定了角色就按角色（收益列里的数
+     * 不论带不带符号都是收益，成本列里的数都是成本；两者都有时
+     * 收益优先；表头里不是收益/成本的数字列，如持有金额，直接跳过）；
+     * 没有表头时，带 +/− 号的是收益（负数恒为收益，成本不可能是
+     * 负数），不带符号的是成本。
+     */
+    let cost = null, gain = null;
+    const hasRoles = !!(colRoles && colRoles.length === parts.length);
+    for (let k = 1; k < numIdx.length; k++) {
+      const tok = parts[numIdx[k]];
+      const role = hasRoles ? (colRoles[numIdx[k]] || '') : '';
+      const v = Number(tok);
+      if (role === 'gain') { if (gain == null) gain = v; continue; }
+      if (role === 'cost') { if (cost == null) cost = v; continue; }
+      if (hasRoles) continue;
+      if (/^[+-]/.test(tok)) { if (gain == null) gain = v; }
+      else if (cost == null) { cost = v; }
+    }
+    // 名字 = 代码之后、第一个数字之前的非数字片段
+    const name = parts.slice(ci + 1)
+      .filter((p, i) => (ci + 1 + i) !== di && !isNum(p)).join('');
+    return this.makeRow(code, shares, cost, buyDate, name, '第 ' + n + ' 行', gain);
+  },
+
+  /**
+   * 行 → 校验后的行。gain 模式（按持有收益导入）与 cost 模式互斥：
+   * 有 gain 时不校验 cost，costNav 留空，等 apply 前按最新净值换算。
+   * 收益可正可负可为零；份额仍须 >0。
+   */
+  makeRow(code, shares, cost, buyDate, name, where, gain) {
+    if (!/^\d{6}$/.test(code || '')) return { error: where + '：基金代码不是 6 位数字' };
+    if (!isFinite(shares) || shares <= 0) return { error: where + '（' + code + '）：份额无效' };
+    if (buyDate && buyDate > todayStr()) return { error: where + '（' + code + '）：买入日期在未来' };
+    if (gain != null) {
+      if (!isFinite(gain)) return { error: where + '（' + code + '）：持有收益无效' };
+      return { code, shares, gain, costNav: null, buyDate: buyDate || null, name: name || '',
+        exists: S.holdings.some(h => h.code === code) };
+    }
+    if (!isFinite(cost) || cost <= 0) return { error: where + '（' + code + '）：成本净值无效' };
+    return { code, shares, costNav: cost, buyDate: buyDate || null, name: name || '',
+      exists: S.holdings.some(h => h.code === code) };
+  },
+
+  /** 同一只代码在粘贴内容里出现多次，以最后一次为准。 */
+  dedupe(rows) {
+    const m = new Map();
+    rows.forEach(r => m.set(r.code, r));
+    return [...m.values()];
+  },
+
+  /** 日期归一化成 YYYY-MM-DD；非法返回 ''。 */
+  normDate(v) {
+    const m = String(v || '').trim().match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})$/);
+    if (!m) return '';
+    const d = m[1] + '-' + m[2].padStart(2, '0') + '-' + m[3].padStart(2, '0');
+    return isNaN(Date.parse(d)) ? '' : d;
+  },
+
+  esc(v) {
+    return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+  },
+};
+
+/** 打开批量导入弹层：粘贴 → 解析预览 → 确认导入。 */
+function openBulkImport() {
+  openSheet(`<h3>批量导入持仓</h3>
+    <div style="color:var(--fg2);font-size:var(--fs-sm);line-height:1.7;margin:-6px 0 12px">
+      一行一只，格式：<b>代码 份额 成本净值 [买入日期]</b>，空格或逗号分隔，基金名可写可不写。<br>
+      第 3 列带 +/− 号表示按持有收益导入（如 018738 1464.57 +201.03），成本会按最新净值自动换算；不带符号的第 3 列仍是成本净值。JSON 里用 gain 字段也行。<br>
+      也支持直接粘贴 JSON（数组，或本 App「导出数据」的格式）。<br>
+      不想复制粘贴也可以点下面「选择文件」，直接选一个 JSON 或文本文件。<br>
+      例：<span style="color:var(--fg)">018738 1681.76 5.2469 2026-04-14</span></div>
+    <textarea id="biText" placeholder="018738 1681.76 5.2469 2026-04-14&#10;006491 29538.04 1.0153 2026-08-01&#10;007227 16753.40 +123.98"
+      style="width:100%;height:150px;background:var(--card);border:1px solid var(--line);
+      border-radius:10px;color:var(--fg);padding:10px;font-size:var(--fs-sm)"></textarea>
+    <div style="margin-top:10px">
+      <label class="btn" for="biFile">选择文件</label>
+      <input type="file" id="biFile" accept=".json,.txt,text/plain,application/json" style="display:none">
+      <span id="biFileName" style="color:var(--fg2);font-size:var(--fs-sm);margin-left:8px"></span>
+    </div>
+    <div id="biPreview" style="margin-top:10px"></div>
+    <button class="btn primary" id="biParse" style="margin-top:10px">解析预览</button>
+    <button class="btn" onclick="closeSheet()">取消</button>`);
+
+  document.getElementById('biParse').onclick = async () => {
+    const parsed = bulkImport.parse(document.getElementById('biText').value);
+    const box = document.getElementById('biPreview');
+    if (!parsed.rows.length && !parsed.errors.length) {
+      box.innerHTML = '<div class="t-dim t-sm" style="padding:8px 0">没有可解析的内容，请按上面的格式粘贴。</div>';
+      return;
+    }
+    // 没写名字的行，按代码联网查一次名（查不到就留空，导入后显示代码）
+    await Promise.all(parsed.rows.filter(r => !r.name).map(async r => {
+      try {
+        const hit = (await api.search(r.code)).find(o => o.code === r.code);
+        if (hit) r.name = hit.name;
+      } catch (e) { /* 查不到不挡导入 */ }
+    }));
+    // 带收益的行：按最新净值换算出成本，预览里一起显示；
+    // 换算不出来的行先标错，确认时不会导入它。
+    await Promise.all(parsed.rows.filter(r => r.gain != null).map(async r => {
+      try {
+        const c = await gainToCost(r.code, r.gain, r.shares, r.name);
+        if (c && isFinite(c.costNav) && c.costNav > 0) {
+          r.costNav = c.costNav; r.gainNav = c.nav;
+        } else {
+          r.gainError = '取不到最新净值，无法按收益换算成本';
+        }
+      } catch (e) {
+        r.gainError = '取不到最新净值，无法按收益换算成本';
+      }
+    }));
+    const rowHtml = parsed.rows.map(r => {
+      let v;
+      if (r.gain != null) {
+        v = fmt(r.shares, 2) + ' 份 · 持有收益 ' + moneyTxt(r.gain);
+        if (r.gainError) {
+          v += ' <b style="color:var(--up)">' + bulkImport.esc(r.gainError) + '</b>';
+        } else if (r.costNav != null) {
+          v += ' · 成本 ' + fmt(r.costNav, 4)
+            + ' <span style="color:var(--dim)">（由收益换算，按最新净值 '
+            + fmt(r.gainNav, 4) + '）</span>';
+        }
+      } else {
+        v = fmt(r.shares, 2) + ' 份 · 成本 ' + fmt(r.costNav, 4);
+      }
+      return '<div class="kv"><span class="k">' + bulkImport.esc(r.name || r.code) + ' · ' + r.code + '</span>'
+        + '<span class="v">' + v
+        + (r.buyDate ? ' · ' + r.buyDate : '')
+        + ' <b style="color:' + (r.exists ? 'var(--up)' : 'var(--accent)') + '">'
+        + (r.exists ? '更新' : '新增') + '</b></span></div>';
+    }).join('');
+    const errHtml = parsed.errors.map(e =>
+      '<div class="t-sm" style="color:var(--up);padding:4px 0">' + bulkImport.esc(e.error) + '</div>').join('');
+    // 换算失败的行不进确认列表，按钮上的只数就是实际会导入的只数
+    const okRows = parsed.rows.filter(r => r.gain == null || r.costNav != null);
+    box.innerHTML = rowHtml + errHtml
+      + (okRows.length
+        ? '<button class="btn primary" id="biOk" style="margin-top:10px">确认导入 '
+          + okRows.length + ' 只</button>'
+        : '<div class="t-dim t-sm" style="padding:8px 0">没有可导入的行。</div>');
+    const ok = document.getElementById('biOk');
+    if (ok) ok.onclick = () => bulkImportApply(okRows);
+  };
+
+  // 选文件：把文件内容读进粘贴框，再走同一套解析预览。
+  // 注意：光有这个 input 还不够，App 的 WebView 必须实现
+  // onShowFileChooser 才会弹出系统选文件器（见 MainActivity）。
+  document.getElementById('biFile').onchange = (ev) => {
