+      + '<span class="t-sm"' + (paused ? ' style="color:var(--dim)"' : '') + '>' + (paused ? '已暂停' : '执行中') + '</span>'
+      + '</div>'
+      + '<div class="kv"><span class="k">每月</span><span class="v">' + p.day + ' 日 · ' + fmt(p.amount, 0) + ' 元</span></div>'
+      + '<div class="kv"><span class="k">下次</span><span class="v">' + nextTxt + '</span></div>'
+      + '<div class="kv"><span class="k">累计投入</span><span class="v">¥' + moneyFull0(st.invested) + '（已买 ' + st.entries.length + ' 笔）</span></div>'
+      + '<div class="kv"><span class="k">总份额 / 均价</span><span class="v">' + fmt(st.shares, 2) + ' 份 · ' + (st.shares > 0 ? fmt(st.costNav, 4) : '--') + '</span></div>'
+      + '<div class="kv"><span class="k">当前市值 / 收益</span><span class="v">' + valueTxt + ' / ' + profitTxt + '</span></div>'
+      + '<div style="display:flex;gap:6px;margin-top:10px">'
+      + '<button class="btn primary" style="flex:1" onclick="openDcaBuy(\'' + p.code + '\')">记一笔</button>'
