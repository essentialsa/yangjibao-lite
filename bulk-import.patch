+    if (!f) return;
+    document.getElementById('biFileName').textContent = f.name;
+    const rd = new FileReader();
+    rd.onload = () => {
+      document.getElementById('biText').value = String(rd.result || '');
+      document.getElementById('biParse').click();
+    };
+    rd.onerror = () => {
+      document.getElementById('biFileName').textContent = '读取失败，请重试';
+    };
+    rd.readAsText(f);
+  };
+}
+
+/**
+ * 按持有收益换算成本：costNav = 当前净值 − gain / shares。
+ *
+ * 取数走 navPairOf（和 1.1.2 货币基金修正同款逻辑）：
+ * 货币基金净值恒为 1，绝不能用 lsjz 的 DWJZ（万份收益，约 0.2）
+ * 当净值。档案/净值没拉到时先拉一次；还取不到就返回 null，
+ * 调用方把该行记为失败、不导入。
+ */
+async function gainToCost(code, gain, shares, name) {
+  // 先拉档案：货币基金的判定（有没有每万份收益序列）要靠它，
+  // 档案没回来之前不能信名字、更不能信 lsjz 的 DWJZ。
+  if (!S.full[code]) {
+    try { S.full[code] = await api.fundFull(code); } catch (e) { /* ignore */ }
+  }
+  // 档案没拉到时用名字兜底（“货币/余额宝/收益宝”等字眼），
+  // 宁可把一只货币基金认出来，也不要拿万份收益当净值算。
+  if (isMoneyFund(code) || /货币|理财|现金管理|现金添利|余额宝|收益宝/.test(name || '')) {
+    return { costNav: 1 - gain / shares, nav: 1 };
+  }
+  if (!S.nav[code]) {
+    try {
+      const list = await api.navHistory(code, 2);
+      if (list.length) S.nav[code] = list[0];
+    } catch (e) { /* ignore */ }
+  }
+  const pair = navPairOf(code);
+  if (!pair || !isFinite(pair.curNav) || !(pair.curNav > 0)) return null;
+  return { costNav: pair.curNav - gain / shares, nav: pair.curNav };
+}
+
+/** 把预览通过的行写进持仓（与单只添加同一套保存逻辑）。 */
+async function bulkImportApply(rows) {
+  let added = 0, updated = 0;
+  const failed = [];
+  for (const r of rows) {
+    // 按收益导入的行：保存前按最新净值换算成本（预览里算过一次，
+    // 这里再算一次为准；取不到净值或换算出的成本不合理就跳过该行）。
+    if (r.gain != null) {
+      let c = null;
+      try { c = await gainToCost(r.code, r.gain, r.shares, r.name); } catch (e) { /* ignore */ }
+      if (!c || !isFinite(c.costNav) || c.costNav <= 0) {
+        failed.push({ code: r.code, name: r.name || r.code,
+          reason: '取不到最新净值，无法按收益换算成本' });
+        continue;
+      }
+      r.costNav = c.costNav;
+    }
+    const patch = { shares: r.shares, costNav: r.costNav,
+      group: r.group || '默认', divMode: r.divMode || 'cash',
+      buyDate: r.buyDate || null };
+    if (r.name) patch.name = r.name;
+    const exist = S.holdings.find(h => h.code === r.code);
+    if (exist) {
+      Object.assign(exist, patch);
+      updated++;
+      // 更新份额时像单只编辑一样记一条今天快照，让收益率曲线不断档
+      txLog.record(r.code, todayStr(), r.shares);
+    } else {
+      S.holdings.push(Object.assign({ code: r.code, addedAt: todayStr() }, patch));
+      added++;
+      // 新持仓还没有流水：用买入日（没有就用今天）补一条基线，
+      // 历史收益才能从买入那天算起；已有流水的不动 —— 往中间插
+      // 一条过去的快照会打乱快照顺序。
+      txLog.record(r.code, r.buyDate || todayStr(), r.shares);
+    }
+  }
+  store.save();
+  closeSheet();
+  await refreshNav();
+  render();
+  toast('已导入 ' + (added + updated) + ' 只（新增 ' + added + '，更新 ' + updated + '）');
+  // 按收益换算失败的行没入库，在这里把原因交代清楚（toast 只显示 1.7 秒，写不下）。
+  if (failed.length) {
+    openSheet('<h3>有 ' + failed.length + ' 只未导入</h3>'
+      + failed.map(f => '<div class="kv"><span class="k">' + bulkImport.esc(f.name)
+        + ' · ' + f.code + '</span><span class="v" style="color:var(--up)">'
+        + bulkImport.esc(f.reason) + '</span></div>').join('')
+      + '<div style="color:var(--fg2);font-size:var(--fs-sm);line-height:1.7;margin:8px 0">'
+      + '可以联网后重新导入这几只，或改按成本净值导入。</div>'
+      + '<button class="btn" onclick="closeSheet()">知道了</button>');
+  }
+}
