+ *
+ * 取数走 navPairOf（和 1.1.2 货币基金修正同款逻辑）：
+ * 货币基金净值恒为 1，绝不能用 lsjz 的 DWJZ（万份收益，约 0.2）
+ * 当净值。档案/净值没拉到时先拉一次；还取不到就返回 null，
+ * 调用方把该行记为失败、不导入。
+ */
+async function gainToCost(code, gain, shares, name) {
+  // 先拉档案：货币基金的判定（有没有每万份收益序列）要靠它，
+  // 档案没回来之前不能信名字、更不能信 lsjz 的 DWJZ。
+  if (!S.full[code]) {
+    try { S.full[code] = await api.fundFull(code); } catch (e) { /* ignore */ }
+  }
+  // 档案没拉到时用名字兜底（“货币/余额宝/收益宝”等字眼），
+  // 宁可把一只货币基金认出来，也不要拿万份收益当净值算。
+  if (isMoneyFund(code) || /货币|理财|现金管理|现金添利|余额宝|收益宝/.test(name || '')) {
+    return { costNav: 1 - gain / shares, nav: 1 };
+  }
+  if (!S.nav[code]) {
+    try {
+      const list = await api.navHistory(code, 2);
+      if (list.length) S.nav[code] = list[0];
+    } catch (e) { /* ignore */ }
+  }
+  const pair = navPairOf(code);
+  if (!pair || !isFinite(pair.curNav) || !(pair.curNav > 0)) return null;
+  return { costNav: pair.curNav - gain / shares, nav: pair.curNav };
+}
+
+/** 把预览通过的行写进持仓（与单只添加同一套保存逻辑）。 */
+async function bulkImportApply(rows, dcaData) {
+  let added = 0, updated = 0;
+  const failed = [];
+  for (const r of rows) {
+    // 按收益导入的行：保存前按最新净值换算成本（预览里算过一次，
+    // 这里再算一次为准；取不到净值或换算出的成本不合理就跳过该行）。
+    if (r.gain != null) {
+      let c = null;
+      try { c = await gainToCost(r.code, r.gain, r.shares, r.name); } catch (e) { /* ignore */ }
+      if (!c || !isFinite(c.costNav) || c.costNav <= 0) {
+        failed.push({ code: r.code, name: r.name || r.code,
+          reason: '取不到最新净值，无法按收益换算成本' });
+        continue;
+      }
+      r.costNav = c.costNav;
+    }
+    const patch = { shares: r.shares, costNav: r.costNav,
+      group: r.group || '默认', divMode: r.divMode || 'cash',
+      buyDate: r.buyDate || null };
+    if (r.name) patch.name = r.name;
+    const exist = S.holdings.find(h => h.code === r.code);
+    if (exist) {
+      Object.assign(exist, patch);
+      updated++;
+      // 更新份额时像单只编辑一样记一条今天快照，让收益率曲线不断档
+      txLog.record(r.code, todayStr(), r.shares);
+    } else {
+      S.holdings.push(Object.assign({ code: r.code, addedAt: todayStr() }, patch));
+      added++;
+      // 新持仓还没有流水：用买入日（没有就用今天）补一条基线，
+      // 历史收益才能从买入那天算起；已有流水的不动 —— 往中间插
+      // 一条过去的快照会打乱快照顺序。
+      txLog.record(r.code, r.buyDate || todayStr(), r.shares);
+    }
+  }
+  // 导入 JSON 里带了定投数据：整批替换，并把涉及基金的持仓按推导值重算
+  const dcaR = dcaData ? dca.applyImport(dcaData) : { plans: 0, logCount: 0 };
+  store.save();
+  closeSheet();
+  await refreshNav();
+  render();
+  toast('已导入 ' + (added + updated) + ' 只（新增 ' + added + '，更新 ' + updated + '）'
+    + (dcaR.plans ? '，定投计划 ' + dcaR.plans + ' 个、购买记录 ' + dcaR.logCount + ' 条' : ''));
+  // 按收益换算失败的行没入库，在这里把原因交代清楚（toast 只显示 1.7 秒，写不下）。
+  if (failed.length) {
+    openSheet('<h3>有 ' + failed.length + ' 只未导入</h3>'
+      + failed.map(f => '<div class="kv"><span class="k">' + bulkImport.esc(f.name)
+        + ' · ' + f.code + '</span><span class="v" style="color:var(--up)">'
+        + bulkImport.esc(f.reason) + '</span></div>').join('')
+      + '<div style="color:var(--fg2);font-size:var(--fs-sm);line-height:1.7;margin:8px 0">'
+      + '可以联网后重新导入这几只，或改按成本净值导入。</div>'
+      + '<button class="btn" onclick="closeSheet()">知道了</button>');
+  }
+}
+
+/* ---------------- 定投管理（v1.2.0 新增） ---------------- */
+
+/**
+ * 定投：每月固定一天买固定金额，份额与均价自动算。
+ *
+ * 背景：批量导入只能录静态持仓（份额 + 成本），没有定投概念；
+ * 每月买一次，份额和均价都在变，只能手动重导。定投把这件事
+ * 变成：建一个计划 → 每次买完记一笔 → 持仓自动更新。
+ *
+ * 数据模型（存在 db 里，和 holdings 一个待遇，导出/导入也带上）：
+ *   计划 dcaPlans: [{code, name, amount, day, startDate, active,
+ *                    baseShares, baseCostNav}]
+ *     amount 每期金额（元），day 每月几号（1-31），
+ *     startDate 计划开始日，active 是否执行中，
+ *     baseShares/baseCostNav 建计划那天持仓的份额/均价（基线）。
+ *   记录 dcaLog: {code: [{date, amount, nav, shares}]}
+ *     date 购买日，amount 实付金额，nav 当日净值，
+ *     shares 实际到账份额（金额 / 净值算出，可手动改；
+ *     平台扣了手续费就按实到份额填，均价自然就对了）。
+ *
+ * 核心不变量：定投基金的持仓份额与均价永远等于
+ *   基线 + 购买记录 推导出来的值：
+ *   份额 = baseShares + Σ shares
+ *   均价 = (baseShares × baseCostNav + Σ amount) / 份额
+ * 记一笔、删一笔、导入恢复都会重算并写回持仓；收益分析读持仓，
+ * 所以不用另改口径。
+ *
+ * 份额变动同时同步 txLog 快照（和批量导入 / 单只编辑同一套做法，
+ * 否则历史收益会把加仓当成赚了）。同步时保留基线日之前的快照
+ * （那是建计划前的持仓历史），只重建基线日及之后的快照；
+ * 所以直接改定投基金的持仓（持仓页编辑）会被下一次定投重算覆盖，
+ * 要改数请改购买记录，不要直接改持仓。
+ *
+ * 注意：定投只管记账，不发提醒、不发通知（用户明确不要提醒），
+ * 下次日期只在列表里显示。
+ */
+const dca = {
+  PLANS_KEY: 'dcaPlans',
+  LOG_KEY: 'dcaLog',
+  plans: null,
+  log: null,
+
+  load() {
+    if (this.plans !== null && this.log !== null) return;
+    let plans = [];
+    try { plans = JSON.parse(db.get(this.PLANS_KEY) || '[]'); } catch (e) { plans = []; }
+    if (!Array.isArray(plans)) plans = [];
+    this.plans = plans.map(p => this.validatePlan(p).plan).filter(Boolean);
+    let log = {};
+    try { log = JSON.parse(db.get(this.LOG_KEY) || '{}'); } catch (e) { log = {}; }
+    if (!log || typeof log !== 'object' || Array.isArray(log)) log = {};
+    const codes = new Set(this.plans.map(p => p.code));
+    this.log = {};
+    Object.keys(log).forEach(code => {
+      if (!codes.has(code)) return;
+      const arr = Array.isArray(log[code]) ? log[code] : [];
+      const es = arr.map(e => this.validateEntry(e).entry).filter(Boolean);
+      es.sort((a, b) => a.date < b.date ? -1 : 1);
+      if (es.length) this.log[code] = es;
+    });
+  },
+
+  save() {
+    db.set(this.PLANS_KEY, JSON.stringify(this.plans || []));
+    db.set(this.LOG_KEY, JSON.stringify(this.log || {}));
+  },
+
+  validatePlan(p) {
+    if (!p || typeof p !== 'object') return { plan: null, error: '不是对象' };
+    const code = String(p.code || '').trim();
+    if (!/^\d{6}$/.test(code)) return { plan: null, error: '基金代码应为 6 位数字' };
+    const amount = +p.amount;
+    if (!isFinite(amount) || amount <= 0) return { plan: null, error: '每期金额应大于 0' };
+    const day = Math.floor(+p.day);
+    if (!isFinite(day) || day < 1 || day > 31) return { plan: null, error: '每月几号应在 1-31 之间' };
+    const startDate = String(p.startDate || '').trim();
+    if (startDate && !/^\d{4}-\d{2}-\d{2}$/.test(startDate)) return { plan: null, error: '开始日期格式不对' };
+    return {
+      plan: {
+        code,
+        name: String(p.name || code).trim() || code,
+        amount: Math.round(amount * 100) / 100,
+        day,
+        startDate: startDate || todayStr(),
+        active: p.active !== false,
+        baseShares: Math.max(0, +p.baseShares || 0),
+        baseCostNav: Math.max(0, +p.baseCostNav || 0),
+      },
+      error: null,
+    };
+  },
+
+  validateEntry(e) {
+    if (!e || typeof e !== 'object') return { entry: null, error: '不是对象' };
+    const date = String(e.date || '').trim();
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return { entry: null, error: '购买日期格式不对' };
+    const amount = +e.amount;
+    if (!isFinite(amount) || amount <= 0) return { entry: null, error: '金额应大于 0' };
+    const nav = +e.nav;
+    if (!isFinite(nav) || nav <= 0) return { entry: null, error: '净值应大于 0' };
+    const shares = +e.shares;
+    if (!isFinite(shares) || shares <= 0) return { entry: null, error: '份额应大于 0' };
+    return {
+      entry: {
+        date,
+        amount: Math.round(amount * 100) / 100,
+        nav: Math.round(nav * 10000) / 10000,
+        shares,
+      },
+      error: null,
+    };
+  },
+
+  planFor(code) {
+    this.load();
+    return this.plans.find(p => p.code === code) || null;
+  },
+
+  logFor(code) {
+    this.load();
+    return this.log[code] || [];
+  },
+
+  countActive() {
+    this.load();
+    return this.plans.filter(p => p.active !== false).length;
+  },
+
+  /**
+   * 纯推导：基线 + 购买记录 → 份额 / 均价 / 累计投入。
+   * 不碰任何外部状态，测试直接调它。
+   */
+  derive(plan, entries) {
+    const baseShares = Math.max(0, +plan.baseShares || 0);
+    const baseCostNav = Math.max(0, +plan.baseCostNav || 0);
+    let logShares = 0, logAmount = 0;
+    for (const e of (entries || [])) {
+      logShares += Math.max(0, +e.shares || 0);
+      logAmount += Math.max(0, +e.amount || 0);
+    }
+    const shares = baseShares + logShares;
+    const invested = baseShares * baseCostNav + logAmount;
+    const costNav = shares > 0 ? invested / shares : 0;
+    return { shares, costNav, invested, logShares, logAmount, baseShares, baseCostNav };
+  },
+
+  /**
+   * 下次购买日（纯函数）：从今天所在月开始找，第一个
+   * 「当月没有购买记录」的 day 号；day 超过当月天数就取月底。
+   * 计划没开始（startDate 在未来）就从开始日那月找。
+   * 已暂停返回 null。只做显示，不发提醒。
+   */
+  nextDate(plan, today, entries) {
+    if (!plan || plan.active === false) return null;
+    const day = Math.min(31, Math.max(1, Math.floor(+plan.day || 1)));
+    const t = today || todayStr();
+    const from = (plan.startDate && plan.startDate > t) ? plan.startDate : t;
+    const fy = +from.slice(0, 4), fm = +from.slice(5, 7);
+    const log = entries || [];
+    for (let k = 0; k < 24; k++) {
+      const yy = fy + Math.floor((fm - 1 + k) / 12);
+      const mm = (fm - 1 + k) % 12 + 1;
+      const lastDay = new Date(yy, mm, 0).getDate();
+      const dd = Math.min(day, lastDay);
+      const cand = yy + '-' + String(mm).padStart(2, '0') + '-' + String(dd).padStart(2, '0');
+      if (cand < from) continue;
+      if (log.some(e => e.date.slice(0, 7) === cand.slice(0, 7))) continue;
+      return cand;
+    }
+    return null;
+  },
+
+  createPlan(plan) {
+    this.load();
+    const v = this.validatePlan(plan);
+    if (v.error) return { ok: false, error: v.error };
+    if (this.planFor(v.plan.code)) return { ok: false, error: '该基金已有定投计划' };
+    // 基线 = 建计划这一刻的持仓（没有持仓就是 0）
+    const h = S.holdings.find(x => x.code === v.plan.code);
+    v.plan.baseShares = h ? Math.max(0, +h.shares || 0) : 0;
+    v.plan.baseCostNav = h ? Math.max(0, +h.costNav || 0) : 0;
+    this.plans.push(v.plan);
+    this.save();
+    return { ok: true, plan: v.plan };
+  },
+
+  updatePlan(code, patch) {
+    this.load();
+    const plan = this.planFor(code);
+    if (!plan) return { ok: false, error: '计划不存在' };
+    const merged = Object.assign({}, plan, patch, { code });
+    const v = this.validatePlan(merged);
+    if (v.error) return { ok: false, error: v.error };
+    // 基线是建计划时定的，编辑不改基线
+    v.plan.baseShares = plan.baseShares;
+    v.plan.baseCostNav = plan.baseCostNav;
+    Object.assign(plan, v.plan);
+    this.save();
+    return { ok: true, plan };
+  },
+
+  deletePlan(code) {
+    this.load();
+    this.plans = this.plans.filter(p => p.code !== code);
+    delete this.log[code];
+    this.save();
+    // 持仓不动：保留最后一次推导出的份额与均价
+  },
+
+  addPurchase(code, entry) {
+    this.load();
+    const plan = this.planFor(code);
+    if (!plan) return { ok: false, error: '计划不存在' };
+    const v = this.validateEntry(entry);
+    if (v.error) return { ok: false, error: v.error };
+    if (v.entry.date > todayStr()) return { ok: false, error: '不能记未来的购买' };
+    if (!this.log[code]) this.log[code] = [];
+    this.log[code].push(v.entry);
+    this.log[code].sort((a, b) => a.date < b.date ? -1 : 1);
+    this.applyToHolding(code);
+    this.save();
+    return { ok: true, entry: v.entry };
+  },
+
+  deletePurchase(code, idx) {
+    this.load();
+    const arr = this.log[code];
+    if (!arr || idx < 0 || idx >= arr.length) return { ok: false, error: '记录不存在' };
+    arr.splice(idx, 1);
+    if (!arr.length) delete this.log[code];
+    this.applyToHolding(code);
+    this.save();
+    return { ok: true };
+  },
+
+  /**
+   * 核心不变量落盘：把推导出的份额/均价写回持仓，并同步 txLog。
+   * 基金还没持仓且推导出份额 > 0 时建一条持仓（基线为 0 的新定投
+   * 记第一笔后就是这种情况）。
+   */
+  applyToHolding(code) {
+    this.load();
+    const plan = this.planFor(code);
+    if (!plan) return false;
+    const d = this.derive(plan, this.logFor(code));
+    let h = S.holdings.find(x => x.code === code);
+    if (!h) {
+      if (!(d.shares > 0)) return false;
+      h = { code, name: plan.name || code, shares: 0, costNav: 0, group: '默认', divMode: 'cash', buyDate: plan.startDate || null, addedAt: todayStr() };
+      S.holdings.push(h);
+    }
+    h.shares = d.shares;
+    h.costNav = d.costNav;
+    this.syncTxLog(code);
+    store.save();
+    return true;
+  },
+
+  /**
+   * 按「基线 + 购买记录」重建该基金的 txLog 快照。
+   * 保留基线日之前的快照（建计划前的持仓历史），只重建基线日
+   * 及之后的快照——所以删一笔、补登一笔旧的，都能正确重算。
+   * 基线日 = 开始日与第一笔购买日中较早的一天（允许补登开始日
+   * 之前的购买，比如 11-13 买的、11-14 才建计划）。
+   */
+  syncTxLog(code) {
+    const plan = this.planFor(code);
+    if (!plan) return;
+    const entries = this.logFor(code);
+    const firstDate = entries.length ? entries[0].date : null;
+    const baseDate = (plan.startDate && firstDate)
+      ? (plan.startDate < firstDate ? plan.startDate : firstDate)
+      : (plan.startDate || firstDate || todayStr());
+    const derived = [];
+    if (plan.baseShares > 0) derived.push({ d: baseDate, s: plan.baseShares });
+    let cum = plan.baseShares;
+    for (const e of entries) {
+      cum += (+e.shares || 0);
+      const last = derived[derived.length - 1];
+      if (last && last.d === e.date) last.s = cum;
+      else derived.push({ d: e.date, s: cum });
+    }
+    const data = txLog.load();
+    const arr = (data[code] || []).filter(it => it.d < baseDate);
+    for (const it of derived) {
+      let i = 0;
+      while (i < arr.length && arr[i].d < it.d) i++;
+      if (i < arr.length && arr[i].d === it.d) arr[i].s = it.s;
+      else arr.splice(i, 0, { d: it.d, s: it.s });
+    }
+    data[code] = arr;
+    txLog.save();
+  },
+
+  /**
+   * 定投统计（给列表页用）：推导值 + 持仓算出的市值/收益。
+   * 没有持仓时市值与收益是 0（还没买进）。
+   */
+  stats(code) {
+    const plan = this.planFor(code);
+    if (!plan) return null;
+    const entries = this.logFor(code);
+    const d = this.derive(plan, entries);
+    const h = S.holdings.find(x => x.code === code);
+    let value = 0, profit = 0, profitPct = 0, curNav = 0;
+    if (h) {
+      const c = holdCalc(h);
+      value = c.value; profit = c.profit; profitPct = c.profitPct; curNav = c.nav;
+    }
+    return {
+      plan, entries,
+      shares: d.shares, costNav: d.costNav,
+      invested: d.invested, logShares: d.logShares, logAmount: d.logAmount,
+      hasHolding: !!h, value, profit, profitPct, curNav,
+      next: this.nextDate(plan, todayStr(), entries),
+    };
+  },
+
+  /**
+   * 解析导出 JSON 里的定投部分（给批量导入用）。
+   * 没有定投数据返回 null；有则返回清洗后的 {plans, log, logCount, errors}。
+   * 没有对应计划的购买记录会被忽略（写进 errors）。
+   */
+  parseExport(j) {
+    if (!j || typeof j !== 'object') return null;
+    const hasPlans = Array.isArray(j.dcaPlans);
+    const hasLog = j.dcaLog && typeof j.dcaLog === 'object' && !Array.isArray(j.dcaLog);
+    if (!hasPlans && !hasLog) return null;
+    const plans = [], errors = [];
+    (j.dcaPlans || []).forEach((p, i) => {
+      const v = this.validatePlan(p);
+      if (v.error) errors.push('定投计划第 ' + (i + 1) + ' 条：' + v.error);
+      else if (plans.some(x => x.code === v.plan.code)) errors.push('定投计划第 ' + (i + 1) + ' 条：' + v.plan.code + ' 重复');
+      else plans.push(v.plan);
+    });
+    const planCodes = new Set(plans.map(p => p.code));
+    const log = {};
+    let logCount = 0;
+    Object.keys(j.dcaLog || {}).forEach(code => {
+      const arr = j.dcaLog[code];
+      if (!Array.isArray(arr)) { errors.push('定投记录 ' + code + ' 不是数组'); return; }
+      if (!planCodes.has(code)) { errors.push('定投记录 ' + code + ' 没有对应计划，已忽略'); return; }
+      const es = [];
+      arr.forEach((e, i) => {
+        const v = this.validateEntry(e);
+        if (v.error) errors.push('定投记录 ' + code + ' 第 ' + (i + 1) + ' 条：' + v.error);
+        else es.push(v.entry);
+      });
+      es.sort((a, b) => a.date < b.date ? -1 : 1);
+      if (es.length) { log[code] = es; logCount += es.length; }
+    });
+    return { plans, log, logCount, errors };
+  },
+
+  /**
+   * 导入时整批替换定投数据，并把涉及基金的持仓按推导值重算。
+   * 返回导入的计划数与记录数（给导入结果提示用）。
+   */
+  applyImport(dcaData) {
+    if (!dcaData) return { plans: 0, logCount: 0 };
+    this.load();
+    this.plans = dcaData.plans;
+    this.log = dcaData.log;
+    this.save();
+    const affected = new Set(dcaData.plans.map(p => p.code));
+    for (const code of affected) this.applyToHolding(code);
+    return { plans: dcaData.plans.length, logCount: dcaData.logCount };
+  },
+};
+
+/* ---------------- 定投界面 ---------------- */
+
+const dcaEsc = v => String(v == null ? '' : v)
