+  const act = dca.countActive();
+  const nexts = dca.plans.filter(p => p.active !== false)
+    .map(p => dca.nextDate(p, todayStr(), dca.logFor(p.code)))
+    .filter(Boolean).sort();
+  return act + ' 个执行中' + (nexts.length ? ' · 下次 ' + nexts[0] : '');
+}
+
+/** 定投计划列表（从 设置 → 数据 → 定投管理 进来）。 */
